import { useState } from 'react'
import heroImg from './assets/hero.png'
import reactLogo from './assets/react.svg'
import viteLogo from './assets/vite.svg'
import './App.css'

function App() {
  
  const [desc, setDesc] = useState('');
  const [amount, setAmount] = useState('');

  const [expList, setExpList] = useState([]);

  const handleSubmit = (event) => {

    event.preventDefault();

    setExpList([... expList,{desc,amount:parseFloat(amount)}]);
    setDesc("");
    setAmount("");
  }

  const total = expList.reduce((acc, cur) => acc + cur.amount, 0);


  return (
    <div>
      <form onSubmit={handleSubmit}>
        <input type="text" placeholder='enter expense' value={desc}
        onChange={(e) => setDesc(e.target.value)} />
        <input type="number" placeholder='enter amount' value={amount}
        onChange={(e) => setAmount(e.target.value)} />
        <button type='submit'>Add</button>
      </form>
      <div>
        <ul>
          {expList.map((exp, idx) => (
            <li key={idx}>{exp.desc} : ${exp.amount}</li>
          ))}
        </ul>
        <h2>total : ${total}</h2>
      </div>

    </div>
    
  )
}

export default App
